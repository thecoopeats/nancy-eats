# Postgres connection string (Neon via the Vercel Marketplace)
DATABASE_URL=
# Random secret for sessions: run `npx auth secret`
AUTH_SECRET=
# Resend API key for sign-in emails (https://resend.com)
AUTH_RESEND_KEY=
# Sender address on a domain verified in Resend
AUTH_EMAIL_FROM="Nancy Eats <hello@example.com>"
# Spoonacular API key (used from step 2)
SPOONACULAR_API_KEY=
# Time zone for "today" on the meal plan (default America/New_York)
APP_TIMEZONE=America/New_York
